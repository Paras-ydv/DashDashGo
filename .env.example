# -----------------------------------------------------------------------------
# DashDashGo environment configuration
#
#   cp .env.example .env
#
# Placeholders only. Replace every `change-me` value before running anywhere
# other than your laptop. `.env` is git-ignored and must never be committed.
# -----------------------------------------------------------------------------

# --- ClickHouse (destination warehouse + pipeline metadata) -------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=dashdashgo
CLICKHOUSE_PASSWORD=change-me-clickhouse
# Database holding pipeline run metadata (pipeline_runs, pipeline_stage_events)
CLICKHOUSE_METADATA_DATABASE=dashdashgo

# --- Dashboard credentials (used by report configs via ${...}) ----------------
METABASE_URL=http://metabase:3000
METABASE_USERNAME=analyst@dashdashgo.local
METABASE_PASSWORD=change-me-Metabase-1

# --- Demo environment only (Postgres behind the demo Metabase) ----------------
POSTGRES_PASSWORD=change-me-postgres
DEMO_READER_PASSWORD=change-me-reader

# --- Application ---------------------------------------------------------------
LOG_LEVEL=INFO
# Run cron schedules defined in reports/*.yaml inside the API process
SCHEDULER_ENABLED=true
# Days to keep raw/processed/failure artifacts (0 disables pruning)
STORAGE_RETENTION_DAYS=30

# Host port for the DashDashGo UI/API
APP_PORT=8000
