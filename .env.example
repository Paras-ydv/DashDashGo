# -----------------------------------------------------------------------------
# DashDashGo environment configuration
#
#   cp .env.example .env
#
# Placeholders only. Replace every `change-me` value before running anywhere
# other than your laptop. `.env` is git-ignored and must never be committed.
# -----------------------------------------------------------------------------

# --- ClickHouse (destination warehouse + pipeline metadata) -------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=dashdashgo
CLICKHOUSE_PASSWORD=change-me-clickhouse
# Database holding pipeline run metadata (pipeline_runs, pipeline_stage_events)
CLICKHOUSE_METADATA_DATABASE=dashdashgo

# --- Dashboard credentials (used by report configs via ${...}) ----------------
METABASE_URL=http://metabase:3000
METABASE_USERNAME=analyst@dashdashgo.local
METABASE_PASSWORD=change-me-Metabase-1

# --- Demo environment only (Postgres behind the demo Metabase) ----------------
POSTGRES_PASSWORD=change-me-postgres
DEMO_READER_PASSWORD=change-me-reader

# --- Application ---------------------------------------------------------------
LOG_LEVEL=INFO
# Run cron schedules defined in reports/*.yaml inside the API process
SCHEDULER_ENABLED=true
# Days to keep raw/processed/failure artifacts (0 disables pruning)
STORAGE_RETENTION_DAYS=30

# Host port for the DashDashGo UI/API
APP_PORT=8000

# --- Security (see README "Security") ------------------------------------------
# HTTP Basic login for the UI and API; off while either is empty.
# /api/health and /static stay public. Use `curl -u user:pass` for the API.
AUTH_USERNAME=
AUTH_PASSWORD=
# Environment variables report configs may reference as ${...} (comma-separated
# glob patterns). CLICKHOUSE_*, POSTGRES_*, AI_* and AUTH_* are always refused.
CONFIG_ENV_ALLOWLIST=METABASE_*,DASHBOARD_*,REPORT_*
# Dashboard hosts a config may point the browser (and the credentials) at.
# Empty = the host of METABASE_URL; "*" = any host.
ALLOWED_DASHBOARD_HOSTS=

# --- Optional AI assistant (failure diagnosis, config drafting) -----------------
# Any OpenAI-compatible API. Free keys, no billing needed:
#   Google AI Studio  https://aistudio.google.com/apikey   (default below)
#   Groq              https://console.groq.com/keys        AI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter        https://openrouter.ai/keys           AI_BASE_URL=https://openrouter.ai/api/v1
# Leave AI_API_KEY empty to switch the assistant off.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Tried in order; later models are fallbacks when one is overloaded.
AI_MODEL=gemini-3.6-flash,gemini-flash-latest
